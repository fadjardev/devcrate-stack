# ============================================================
#  Devcrate  —  Portable Multi-PHP Development Stack
#  Versioned:  scripts, docs, and service CONFIGS only.
#  Ignored:    vendored binaries, runtime data, secrets, projects.
#  (Binaries are downloadable; see docs/setup.md to rebuild the stack.)
# ============================================================

# --- Application code (lives in its own repos) ---
/projects/

# --- Downloaded archives & installers ---
*.zip
*.7z
*.tar.gz
/_downloads/
mkcert.exe

# --- Logs, crash dumps, temp ---
*.log
*.dump
erl_crash.dump

# --- Vendored runtimes (downloadable — don't version) ---
/mariadb/
/erlang/
/rabbitmq/
/composer/
/tools/
/node/
/bun/

# --- PostgreSQL: binaries AND the data\ cluster it carries ---
# One un-versioned directory, like mariadb\: the cluster's on-disk format is
# tied to the server version, so data\ lives inside the same folder as the
# binaries and neither half is ours to version. Root-anchored so the
# installer's source (devcrate\src\install\postgres.rs) stays tracked.
/postgres/

# --- Python: the versioned toolchain folders and the current junction ---
# Shaped like php\ but with nothing to keep -- the embeddable distro carries no
# stack-owned config, so unlike php.ini there is no exception to carve out.
# Root-anchored, so devcrate\src\python.rs and devcrate\src\install\python.rs
# are still versioned.
/python/

# --- PHP: keep ONLY each version's php.ini, drop binaries/zips/junction ---
/php/**
!/php/*/
!/php/*/php.ini
/php/current/

# --- Nginx: keep ONLY the prefix's conf/, drop binaries, logs, temp, keys ---
# nginx\ is the prefix: conf\ belongs to the stack and is versioned, and
# everything else under it is runtime -- logs\, temp\, the projects and
# current junctions, and the versioned builds (nginx\nginx-1.31.1\) that now
# live inside it.
/nginx/**
!/nginx/conf/
!/nginx/conf/**
/nginx/conf/certs/

# The pre-restructure layout, where the versioned folder was itself the
# prefix. Nothing in it is tracked any more -- `devcrate nginx migrate` moves
# what matters into nginx\ -- so the whole thing is ignored rather than
# carefully carved up. Wildcarded, not spelled nginx-1.31.1: these rules used
# to name one version, so a second unpacked nginx matched none of them and its
# nginx.exe and conf\certs\*-key.pem were both committable.
/nginx-*/

# --- TLS private keys, wherever they end up ---
# A belt to the certs\ rule above rather than a replacement for it. mkcert names
# every private key <name>-key.pem, its own CA included, so this still holds if
# a certificate directory is moved or a new one appears somewhere the paths
# above do not reach.
*-key.pem

# --- Rust: keep the crate sources + Cargo.lock, drop build output ---
/devcrate/target/
# The built binary, copied to the stack root so `devcrate` resolves on PATH
# (the stack root is already there for the .bat helpers). Build output, not
# source: rebuild it with `cargo build --release` in devcrate\.
/devcrate.exe

# --- Claude Code local settings (machine-specific) ---
.claude/settings.local.json

# --- OS / editor junk ---
Thumbs.db
Desktop.ini
.DS_Store
*.swp
